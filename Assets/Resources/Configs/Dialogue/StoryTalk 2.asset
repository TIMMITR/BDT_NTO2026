  lines:
  - speaker: 0
    text: "\u041A\u0430\u043A \u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u043C\u0435\u043D\u044F \u043F\u0435\u0440\u0435\u0438\u0433\u0440\u0430\u0442\u044C!?"
    emotion: 
    voice: {fileID: 0}
  - speaker: 0
    text: "\u0415\u0449\u0435 \u043E\u0434\u043D\u0443 \u0438\u0433\u0440\u0443! "
    emotion: 
    voice: {fileID: 0}
  - speaker: 1
    text: "\u041D\u043E \u043C\u0430\u0441\u0442\u0435\u0440, \u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u043E 3 \u0438\u0433\u0440\u0430\u0445..."
    emotion: 
    voice: {fileID: 0}
  - speaker: 0
    text: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0442\u043E \u0442\u044B \u0442\u043E\u0447\u043D\u043E
      \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u0435\u0448\u044C!"
    emotion: 
