  m_Script: {fileID: 11500000, guid: 5c47d651b2da436fa70ba1ac024bd223, type: 3}
  m_Name: StoryTalk 1
  m_EditorClassIdentifier: 
  lines:
  - speaker: 0
    text: "\u0421\u043B\u0430\u0432\u043D\u043E \u043F\u043E\u0438\u0433\u0440\u0430\u043B\u0438,
      \u0443 \u0442\u0435\u0431\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E
      \u0435\u0441\u0442\u044C \u043F\u0440\u0435\u0434\u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043A \u0442\u0430\u043A\u0442\u0438\u043A\u0435."
    emotion: 
    voice: {fileID: 0}
  - speaker: 0
    text: "\u0422\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044E
      \u0442\u0435\u0431\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438 \u0442\u0430\u043A
      \u0436\u0435 \u0437\u0430 \u043C\u0430\u043D\u0443"
    emotion: 
    voice: {fileID: 0}
  - speaker: 1
    text: "\u041A\u0430\u0440\u0442\u044B \u043C\u043E\u0433\u0443\u0442 \u0434\u0430\u0442\u044C
      \u0442\u0435\u0431\u0435 \u043A\u0430\u043A \u0431\u043E\u043D\u0443\u0441\u044B
      \u0442\u0430\u043A \u0438 \u0434\u0435\u0431\u0430\u0444\u044B! \u0410 \u043F\u0435\u0441\u043E\u0447\u043D\u044B\u0435
      \u0447\u0430\u0441\u044B \u0437\u0430\u0441\u0442\u0430\u0432\u044F\u0442 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0445\u043E\u0434!"
    emotion: 
    voice: {fileID: 0}
  - speaker: 0
    text: "\u0418\u0437\u0432\u0438\u043D\u0438\u0441\u044C"
    emotion: 
    voice: {fileID: 0}
  - speaker: 1
    text: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435"
    emotion: 
    voice: {fileID: 0}
  - speaker: 0
    text: "\u041D\u0430\u0447\u043D\u0435\u043C \u0436\u0435 \u0431\u043E\u0439"
    emotion: 
    voice: {fileID: 0}
