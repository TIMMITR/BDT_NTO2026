  pool:
  - speaker: 1
    text: "\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435!
      \u0422\u0432\u043E\u0438 \u044E\u043D\u0438\u0442\u044B \u0441\u0438\u043B\u044C\u043D\u043E
      \u043F\u043E\u0431\u0438\u0442\u044B, \u0432\u043E\u0442 \u0442\u0430\u043A
      \u043F\u043E\u043B\u0443\u0447\u0448\u0435 \u0431\u0443\u0434\u0435\u0442!"
    emotion: 
    voice: {fileID: 0}
  - speaker: 1
    text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043C\u0430\u043D\u0443,
      \u0437\u0430 \u0442\u0430\u043A\u043E\u0439 \u043F\u043E\u0434\u0433\u043E\u043D
      \u044F \u043F\u043E\u0434\u043B\u0435\u0447\u0443 \u0442\u0432\u043E\u0438\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432"
